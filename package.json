{
  "name": "clipboard-shelf",
  "version": "1.2.0",
  "productName": "Clipboard Shelf",
  "author": "Clipboard Shelf",
  "description": "Clipboard history tool for Windows",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "node build.mjs",
    "build:win": "node build.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rebuild-electron.ps1 && electron-builder --win",
    "fix-meta": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fix-exe-meta.ps1",
    "build:win:local": "npm run build:win && npm run fix-meta",
    "pretest": "npm rebuild better-sqlite3",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.24.2",
    "lucide-react": "^0.460.0",
    "node-gyp": "^13.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-virtuoso": "^4.10.0",
    "rollup": "^4.62.0",
    "sharp": "^0.35.3",
    "vite": "^5.4.0"
  }
}
